{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "メインウィンドウ。全コマンドとウィンドウ操作・イベント・クリップボードへの書き込みを許可する（05 §8）。dialog・opener・fs は与えない",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "log:default",
    "core:window:allow-start-dragging",
    "core:window:allow-is-focused",
    "clipboard-manager:allow-write-text",
    "allow-auth-get-session",
    "allow-auth-restore",
    "allow-auth-sign-in",
    "allow-auth-cancel-sign-in",
    "allow-auth-sign-out",
    "allow-connection-list",
    "allow-connection-test",
    "allow-connection-create",
    "allow-connection-update",
    "allow-connection-patch",
    "allow-connection-delete",
    "allow-connection-reorder",
    "allow-connection-last-location",
    "allow-connection-set-location",
    "allow-credential-list",
    "allow-credential-update",
    "allow-bucket-get-info",
    "allow-objects-list-page",
    "allow-object-head",
    "allow-folder-create",
    "allow-folder-summary",
    "allow-folder-children",
    "allow-objects-find-conflicts",
    "allow-objects-delete",
    "allow-objects-move",
    "allow-object-rename",
    "allow-objects-change-storage-class",
    "allow-objects-request-restore",
    "allow-versions-list",
    "allow-version-restore",
    "allow-version-delete",
    "allow-deleted-restore",
    "allow-transfer-subscribe",
    "allow-pick-upload-files",
    "allow-upload-prepare",
    "allow-upload-start",
    "allow-pick-download-dir",
    "allow-download-start",
    "allow-download-reveal",
    "allow-job-cancel",
    "allow-transfer-retry",
    "allow-transfer-clear-finished",
    "allow-search-query",
    "allow-search-index-status",
    "allow-search-index-rebuild",
    "allow-search-index-delete",
    "allow-metrics-storage",
    "allow-cost-summary",
    "allow-cost-refresh",
    "allow-pricing-get",
    "allow-settings-get",
    "allow-settings-update",
    "allow-app-set-theme",
    "allow-app-open-settings",
    "allow-app-startup-info",
    "allow-menu-update-state",
    "allow-app-open-logs",
    "allow-app-clear-cache",
    "allow-app-check-update",
    "allow-app-install-update",
    "allow-app-notify",
    "allow-app-choose-download-dir"
